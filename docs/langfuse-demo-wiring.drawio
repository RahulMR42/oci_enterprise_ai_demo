        <mxCell id="directCaveat" value="Direct hosted URL caveat&#xa;A normal browser redirect to the raw OCI invoke URL cannot attach the IDCS bearer header. The current reliable path is the local launch proxy. For true direct launch, provide an HTTPS callback/base URL and deploy Langfuse with that URL." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
