        </mxCell>
        <mxCell id="httpsNote" value="Direct browser OAuth note&#xa;IDCS requires HTTPS redirect URIs. Localhost HTTP callback is rejected. Direct browser launch needs a real HTTPS callback/base URL." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
