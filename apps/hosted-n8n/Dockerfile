FROM docker.n8n.io/n8nio/n8n:stable

ENV N8N_HOST=0.0.0.0
ENV N8N_LISTEN_ADDRESS=0.0.0.0
ENV N8N_PORT=8080
ENV N8N_SECURE_COOKIE=false
ENV N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false
ENV HOME=/tmp
ENV N8N_USER_FOLDER=/tmp/.n8n

WORKDIR /tmp

EXPOSE 5678
EXPOSE 8080

ENTRYPOINT ["tini", "--"]
CMD ["n8n", "start"]
